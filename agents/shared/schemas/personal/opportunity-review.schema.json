{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opportunity_review",
  "type": "object",
  "required": [
    "opportunity_id",
    "recommendation",
    "status"
  ],
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "matched_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "enum": [
        "APPLY",
        "INVESTIGATE",
        "DEFER"
      ]
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    }
  }
}
