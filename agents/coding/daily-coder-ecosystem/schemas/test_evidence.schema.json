{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "commands",
    "evidence",
    "limitations",
    "verdict"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["argv", "returncode"],
        "properties": {
          "argv": { "type": "array", "items": { "type": "string" } },
          "returncode": { "type": "integer" },
          "duration_s": { "type": "number" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "job_id": { "type": "string" }
  },
  "additionalProperties": false
}
