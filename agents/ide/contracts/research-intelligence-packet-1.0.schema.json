{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-intelligence-packet-1.0.schema.json",
  "title": "Research Intelligence Packet 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "topic",
    "decision",
    "audience",
    "scope",
    "freshness_boundary",
    "corpus_counts",
    "disclosure",
    "sources",
    "evidence",
    "claims",
    "facts",
    "contradictions",
    "examples",
    "gaps",
    "recommendations",
    "role_handoffs",
    "limitations",
    "unprocessed_items",
    "review"
  ],
  "properties": {
    "schema_version": {"const": "research-intelligence-packet/1.0"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED"]},
    "topic": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "freshness_boundary": {"type": ["string", "null"]},
    "corpus_counts": {
      "type": "object",
      "required": ["processed_sources", "unique_lineages", "unprocessed_items"],
      "properties": {
        "processed_sources": {"type": "integer", "minimum": 0},
        "unique_lineages": {"type": "integer", "minimum": 0},
        "unprocessed_items": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "disclosure": {
      "type": "object",
      "required": ["audience_authorized", "handling_notes"],
      "properties": {
        "audience_authorized": {"type": "boolean"},
        "handling_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "examples": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
    "role_handoffs": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {"$ref": "#/$defs/handoff"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "unprocessed_items": {"type": "array", "items": {"type": "object"}},
    "review": {
      "type": "object",
      "required": ["verdict", "residual_weaknesses"],
      "properties": {
        "verdict": {"enum": ["PASS", "REVISE", "INSUFFICIENT_EVIDENCE"]},
        "residual_weaknesses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "classification": {
      "enum": ["CONFIRMED", "CORROBORATED", "SUPPORTED", "INFERRED", "CONFLICTING", "UNKNOWN", "NOT_APPLICABLE"]
    },
    "source": {
      "type": "object",
      "required": ["id", "lineage_id", "title", "source_class", "access_class", "output_handling"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "lineage_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_class": {"type": "string", "minLength": 1},
        "access_class": {"enum": ["PUBLIC", "INTERNAL", "RESTRICTED"]},
        "output_handling": {"enum": ["QUOTE", "CITE_ONLY", "REDACT", "OMIT"]}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "source_id", "lineage_id", "locator", "observation", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "lineage_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "classification", "supporting_evidence_ids", "contradicting_evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "classification": {"$ref": "#/$defs/classification"},
        "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "contradicting_evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": ["id", "text", "classification", "evidence_ids", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "classification": {"$ref": "#/$defs/classification"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "score": {
      "type": "object",
      "required": [
        "importance",
        "expected_impact",
        "difficulty",
        "time_to_value",
        "risk_reduction",
        "ecosystem_leverage",
        "downside_risk",
        "operational_burden",
        "reversibility",
        "evidence_confidence",
        "safety_effect",
        "benefit",
        "burden",
        "raw_priority",
        "confidence_adjusted_priority"
      ],
      "properties": {
        "importance": {"type": "number", "minimum": 0, "maximum": 10},
        "expected_impact": {"type": "number", "minimum": 0, "maximum": 10},
        "difficulty": {"type": "number", "minimum": 0, "maximum": 10},
        "time_to_value": {"type": "number", "minimum": 0, "maximum": 10},
        "risk_reduction": {"type": "number", "minimum": 0, "maximum": 10},
        "ecosystem_leverage": {"type": "number", "minimum": 0, "maximum": 10},
        "downside_risk": {"type": "number", "minimum": 0, "maximum": 10},
        "operational_burden": {"type": "number", "minimum": 0, "maximum": 10},
        "reversibility": {"type": "number", "minimum": 0, "maximum": 5},
        "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "safety_effect": {"type": "number", "minimum": -5, "maximum": 5},
        "benefit": {"type": "number"},
        "burden": {"type": "number"},
        "raw_priority": {"type": "number"},
        "confidence_adjusted_priority": {"type": "number"}
      },
      "additionalProperties": true
    },
    "recommendation": {
      "type": "object",
      "required": [
        "id",
        "title",
        "proposal",
        "rationale",
        "evidence_ids",
        "fact_ids",
        "scores",
        "roadmap_band",
        "rank",
        "sensitivity",
        "effects",
        "prerequisites",
        "dependencies",
        "affected_roles",
        "affected_tools",
        "smallest_safe_experiment",
        "validation_metric",
        "success_threshold",
        "stop_condition",
        "rollback_condition"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "proposal": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "scores": {"$ref": "#/$defs/score"},
        "roadmap_band": {"enum": ["NOW", "NEXT", "EXPERIMENT", "DEFER", "DO_NOT_ADOPT"]},
        "rank": {"type": "integer", "minimum": 1},
        "sensitivity": {
          "type": "object",
          "required": ["stressed_adjusted_priority", "stressed_band", "band_changed"],
          "properties": {
            "stressed_adjusted_priority": {"type": "number"},
            "stressed_band": {"enum": ["NOW", "NEXT", "EXPERIMENT", "DEFER", "DO_NOT_ADOPT"]},
            "band_changed": {"type": "boolean"}
          }
        },
        "effects": {
          "type": "object",
          "required": ["speed", "accuracy", "safety", "maintainability", "cost", "workflow", "users"]
        },
        "prerequisites": {"type": "array"},
        "dependencies": {"type": "array"},
        "affected_roles": {"type": "array"},
        "affected_tools": {"type": "array"},
        "smallest_safe_experiment": {"type": "string"},
        "validation_metric": {"type": "string"},
        "success_threshold": {"type": "string"},
        "stop_condition": {"type": "string"},
        "rollback_condition": {"type": "string"}
      },
      "additionalProperties": true
    },
    "handoff": {
      "type": "object",
      "required": [
        "role",
        "disposition",
        "reason",
        "recommendation_ids",
        "fact_ids",
        "objective",
        "constraints",
        "inputs",
        "required_outputs",
        "acceptance_criteria",
        "dependencies",
        "risks",
        "recommended_action"
      ],
      "properties": {
        "role": {
          "enum": ["Master", "Planner", "Worker", "Reviewer", "Test", "Tester", "Question", "Idea", "Debug", "Integration", "CARLA", "Scenario", "HMI", "Performance", "ROS2", "Environment", "GUI"]
        },
        "disposition": {"enum": ["RECOMMENDED", "DEFER", "DO_NOT_ADOPT", "NOT_APPLICABLE"]},
        "reason": {"type": "string", "minLength": 1},
        "recommendation_ids": {"type": "array", "items": {"type": "string"}},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "objective": {"type": "string"},
        "constraints": {"type": "array"},
        "inputs": {"type": "array"},
        "required_outputs": {"type": "array"},
        "acceptance_criteria": {"type": "array"},
        "dependencies": {"type": "array"},
        "risks": {"type": "array"},
        "recommended_action": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
