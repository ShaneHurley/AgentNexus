{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deadline_triage",
  "type": "object",
  "required": [
    "items",
    "status"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "due",
          "priority"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "beats_baseline": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
