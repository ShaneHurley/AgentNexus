{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "director_synthesis.schema.json",
  "title": "director_synthesis",
  "type": "object",
  "required": [
    "packet_hash",
    "conclusions",
    "claim_links",
    "alternatives",
    "unfavorable_evidence",
    "experiments",
    "unknowns",
    "format"
  ],
  "additionalProperties": false,
  "properties": {
    "packet_hash": { "type": "string" },
    "conclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["conclusion_id", "text", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "conclusion_id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "premises": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claim_links": { "type": "array", "items": { "type": "string" } },
    "alternatives": { "type": "array", "items": { "type": "string" } },
    "unfavorable_evidence": { "type": "array", "items": { "type": "string" } },
    "experiments": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "format": { "type": "string" }
  }
}
