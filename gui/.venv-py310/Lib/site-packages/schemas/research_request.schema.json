{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_request.schema.json",
  "title": "research_request",
  "type": "object",
  "required": ["topic"],
  "additionalProperties": false,
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "objective": { "type": "string" },
    "intended_decision_or_use": { "type": "string" },
    "direction_or_outline": { "type": "array", "items": { "type": "string" } },
    "seed_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "specific_questions": { "type": "array", "items": { "type": "string" } },
    "audience": { "type": "string" },
    "domain": { "type": "string" },
    "time_horizon": { "type": "string" },
    "geographic_scope": { "type": "string" },
    "source_constraints": { "type": "array", "items": { "type": "string" } },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "required_output": {
      "type": "string",
      "enum": [
        "brief",
        "literature_review",
        "decision_report",
        "architecture_report",
        "feasibility_study",
        "experiment_plan",
        "research_packet",
        "custom"
      ]
    },
    "desired_depth": {
      "type": "string",
      "enum": ["quick", "standard", "deep", "thesis"]
    },
    "budget_profile": { "type": "string", "enum": ["S", "M", "L", "XL"] },
    "recency_requirement": { "type": "string" },
    "confidentiality": {
      "type": "string",
      "enum": ["public", "internal", "restricted"]
    },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "maximum_cost": { "type": "number", "minimum": 0 },
    "deadline": { "type": "string", "format": "date-time" }
  }
}
