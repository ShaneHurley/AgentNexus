{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clarification_result.schema.json",
  "title": "clarification_result",
  "type": "object",
  "required": ["result_type", "confidence"],
  "additionalProperties": false,
  "properties": {
    "result_type": {
      "type": "string",
      "enum": ["questions", "ready"]
    },
    "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["question_id", "text", "options"],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string", "pattern": "^CLQ-" },
          "text": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          },
          "rationale": { "type": "string" }
        }
      }
    },
    "interpreted_objective": { "type": "string" },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "ambiguity_score": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "result_type": { "const": "questions" } } },
      "then": { "required": ["questions"] }
    },
    {
      "if": { "properties": { "result_type": { "const": "ready" } } },
      "then": { "required": ["interpreted_objective"] }
    }
  ]
}
