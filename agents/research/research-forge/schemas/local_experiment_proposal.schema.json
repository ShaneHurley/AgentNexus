{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_experiment_proposal.schema.json",
  "title": "local_experiment_proposal",
  "type": "object",
  "required": [
    "experiment_id",
    "title",
    "question",
    "why_run",
    "hypothesis",
    "expected_support",
    "expected_reject",
    "expected_inconclusive",
    "decision_impact",
    "kind",
    "inputs",
    "estimated_runtime_seconds",
    "repetitions",
    "token_budget"
  ],
  "additionalProperties": false,
  "properties": {
    "experiment_id": { "type": "string", "pattern": "^EXP-[A-Z0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "why_run": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "expected_support": { "type": "string", "minLength": 1 },
    "expected_reject": { "type": "string", "minLength": 1 },
    "expected_inconclusive": { "type": "string", "minLength": 1 },
    "decision_impact": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["dataset_profile", "group_comparison", "python_unittest_benchmark"]
    },
    "inputs": {
      "type": "object",
      "required": ["data_path"],
      "additionalProperties": false,
      "properties": {
        "data_path": { "type": "string", "minLength": 1 },
        "group_column": { "type": "string" },
        "metric_column": { "type": "string" },
        "unittest_start": { "type": "string" }
      }
    },
    "estimated_runtime_seconds": { "type": "integer", "minimum": 1 },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
    "token_budget": { "type": "integer", "const": 0 },
    "idea_id": { "type": "string", "pattern": "^IDEA-" },
    "parent_plan_experiment_id": { "type": "string", "pattern": "^EXP-" },
    "created_at": { "type": "string" }
  }
}
