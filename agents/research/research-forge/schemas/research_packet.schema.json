{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_packet.schema.json",
  "title": "research_packet",
  "type": "object",
  "required": [
    "packet_version",
    "request_id",
    "charter",
    "method",
    "source_registry_ref",
    "evidence_registry_ref",
    "key_findings",
    "contradictions",
    "unknowns",
    "audit_result",
    "allowed_uses",
    "prohibited_uses",
    "freshness",
    "expiry",
    "report_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "packet_version": { "type": "string" },
    "request_id": { "type": "string" },
    "charter": { "type": "object" },
    "method": { "type": "object" },
    "source_registry_ref": { "type": "string" },
    "evidence_registry_ref": { "type": "string" },
    "claim_graph_ref": { "type": "string" },
    "key_findings": { "type": "array", "items": { "type": "object" } },
    "contradictions": { "type": "array", "items": { "type": "object" } },
    "unknowns": { "type": "array", "items": { "type": "object" } },
    "candidate_ideas": { "type": "array", "items": { "type": "string" } },
    "recommendation": { "type": "object" },
    "experiments": { "type": "array", "items": { "type": "string" } },
    "risks_and_boundaries": { "type": "array", "items": { "type": "string" } },
    "cost_and_budget": { "type": "object" },
    "audit_result": { "type": "object" },
    "allowed_uses": { "type": "array", "items": { "type": "string" } },
    "prohibited_uses": { "type": "array", "items": { "type": "string" } },
    "freshness": { "type": "string" },
    "expiry": { "type": "string" },
    "report_hash": { "type": "string" }
  }
}
