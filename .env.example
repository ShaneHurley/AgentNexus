# Copy to .env and fill in locally. Never commit real secrets.

# --- Daily Coder (live providers; mock needs no keys) ---
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LOCAL_API_KEY=
# GITHUB_TOKEN=            # optional; for daily-coder github clone/repo/pulls (prefer GitHub App installation token)
# GH_TOKEN=                # alternate name accepted by resolve_github_token

# --- Research Forge ---
# RF_PACKAGE_ROOT=         # override package root if not auto-detected
# RF_EXPERIMENT_SANDBOX=docker   # optional REC-04: wrap unittest benchmarks in docker --network=none

# --- GUI hub (gui/; Python package agent_dashboard; hub HTTP API only) ---
# AGENT_DASHBOARD_TOKEN=   # hub auth when auth_required is true in config/agents.json
#                          # memory-only at runtime; NOT the Daily Coder child --token (see DAILY_CODER_API_TOKEN)
