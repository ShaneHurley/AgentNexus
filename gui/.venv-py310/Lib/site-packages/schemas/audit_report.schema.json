{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit_report.schema.json",
  "title": "audit_report",
  "type": "object",
  "required": ["audit_id", "sample_seed", "checklist", "findings", "blocked", "veto"],
  "additionalProperties": false,
  "properties": {
    "audit_id": { "type": "string" },
    "sample_seed": { "type": "integer" },
    "sampled_claim_ids": { "type": "array", "items": { "type": "string" } },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "verdict", "evidence_ref"],
        "properties": {
          "item": { "type": "string" },
          "verdict": { "type": "string" },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "severity", "detail"],
        "properties": {
          "item": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "major", "minor", "note"] },
          "detail": { "type": "string" }
        }
      }
    },
    "blocked": { "type": "boolean" },
    "veto": { "type": "boolean" }
  }
}
