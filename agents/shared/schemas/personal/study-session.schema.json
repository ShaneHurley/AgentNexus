{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study_session",
  "type": "object",
  "required": [
    "session_id",
    "objective",
    "hint_level",
    "status"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "user_attempt": {
      "type": "string"
    },
    "hint_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "integrity_ok": {
      "type": "boolean"
    }
  }
}
